# Archivo .env
# Este archivo contiene variables de entorno sensibles.
# NO LO SUBAS A REPOSITORIOS PÚBLICOS (GitHub, GitLab, etc.)

# --- Configuración de la Base de Datos PostgreSQL ---
# Asegúrate de que estos valores coincidan con tu configuración de PostgreSQL
PG_USER="postgres"      # Por ejemplo: postgres
PG_HOST="localhost"             # O la IP de tu servidor de base de datos si no es local
PG_DATABASE="postgres"      # Por ejemplo: turboparking_db
PG_PASSWORD="10010"  # Tu contraseña de PostgreSQL
PG_PORT=5432                    # Puerto por defecto de PostgreSQL

# --- Clave Secreta para JSON Web Tokens (JWT) ---
# Esta clave se usa para firmar y verificar los tokens de autenticación.
# DEBE ser una cadena de texto LARGA, ALEATORIA y SEGURA.
# Puedes generar una online buscando "jwt secret generator" o "random string generator".
JWT_SECRET="una_clave_secreta_muy_larga_y_aleatoria_para_tu_app_turboparking_1234567890ABCDEF"

# --- Puerto para el Servidor Backend ---
# Puerto en el que tu aplicación Node.js escuchará.
PORT=5000